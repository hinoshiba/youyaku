# Swift ビルド成果物
.build/
dist/

# ベンダー依存(Scripts/fetch-vendor.sh で取得する再取得可能なバイナリ)
Vendor/

# macOS / エディタ
.DS_Store
*.swp

# ローカル状態
.claude/scheduled_tasks.lock

# iOS ビルド成果物 / Xcode のユーザー固有状態
ios/build/
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
*.xcuserstate
# App Store Connect API キー(絶対に commit しない)
*.p8

# 配布用 DMG は GitHub Releases に置くため commit しない(履歴が版ごとに数 MiB 太るため)。
#   Scripts/publish-release.sh がアップロードする。詳細は docs/RELEASE.md。
#   一方 appcast.xml / version.txt は GitHub Pages で配信する小さなテキストなので git 管理下に置く。
http_dist/download/*.dmg

# Sparkle の秘密鍵の書き出し(バックアップ用に一時的に作ることがある。絶対に commit しない)
sparkle-private-key*.txt

# ローカル環境変数
.env*
!.env.example
