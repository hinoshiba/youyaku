# Swift ビルド成果物
.build/
dist/

# ベンダー依存(Scripts/fetch-vendor.sh で取得する再取得可能なバイナリ)
Vendor/

# macOS / エディタ
.DS_Store
*.swp

# ローカル状態
.claude/scheduled_tasks.lock

# iOS ビルド成果物 / 生成プロジェクト
ios/build/
ios/Youyaku.xcodeproj/
# App Store 提出用オプション(個人の Team ID を含む。テンプレートは *.example を commit)
ios/ExportOptions.plist
# App Store Connect API キー(絶対に commit しない)
*.p8

# 配布用 DMG / version.txt は git 管理下に置く(手動 commit・あえて .gitignore に列挙しない)。詳細は docs/RELEASE.md。

# ローカル環境変数
.env*
!.env.example
