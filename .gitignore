# Swift ビルド成果物
.build/
dist/

# ベンダー依存(Scripts/fetch-vendor.sh で取得する再取得可能なバイナリ)
Vendor/

# macOS / エディタ
.DS_Store
*.swp

# ローカル状態
.claude/scheduled_tasks.lock

# iOS ビルド成果物 / 生成プロジェクト
ios/build/
ios/Youyaku.xcodeproj/
# App Store 提出用オプション(個人の Team ID を含む。テンプレートは *.example を commit)
ios/ExportOptions.plist
# App Store Connect API キー(絶対に commit しない)
*.p8

# 配布用 DMG / version.txt は git 管理下に置く(手動 commit)。
#   非公開リポジトリのため GitHub Releases は使わず、公証済み DMG をリポジトリに含めて
#   GitHub Actions が Cloudflare Workers へサイトごとデプロイする。詳細は docs/RELEASE.md。
#   → ここでは無視しない(あえて .gitignore に列挙しない)

# npm(package-lock.json はコミット対象なので除外しない)
node_modules/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
