<?xml version="1.0" encoding="UTF-8"?>
<!--
  App Store Connect へアップロードする際の xcodebuild -exportArchive 用オプション。
  このファイルを ExportOptions.plist にコピーし、teamID を自分の Team ID に差し替えて使う。
  （ExportOptions.plist は個人の Team ID を含むため .gitignore 済み。この .example のみ commit する）
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store 配布(Xcode 15.3 以降は "app-store-connect"、それ以前は "app-store") -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- あなたの Apple Developer Team ID(10 桁。Developer サイト > Membership で確認) -->
	<key>teamID</key>
	<string>XXXXXXXXXX</string>

	<!-- 自動署名(証明書・プロファイルを Xcode に任せる) -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- クラッシュ解析用シンボルをアップロードする -->
	<key>uploadSymbols</key>
	<true/>

	<!-- exportArchive の完了と同時に App Store Connect へアップロードする。
	     .ipa をローカルに出すだけにしたい場合は "export" にする -->
	<key>destination</key>
	<string>upload</string>
</dict>
</plist>
